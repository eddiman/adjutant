{
  "permissions": {
    "allow": ["Read", "Glob", "Grep"],
    "deny": [
      "Bash(*)",
      "Edit(*)", "Write(*)",
      "Read(.env)", "Read(**/.env)", "Read(**/.env.*)",
      "Read(**/*secret*)", "Read(**/*credential*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-env-read.sh"
          }
        ]
      }
    ]
  }
}
